{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quantumbot_harness/schemas/spec.schema.json",
  "title": "QuantumBot Harness SPEC",
  "description": "Schema for a formal Specification (SPEC) authorizing changes to QuantumBot Pro.",
  "type": "object",
  "required": ["schema_version", "spec_id", "title", "status", "owner", "created_at", "objective", "scope_in", "scope_out", "files_allowed_to_modify", "files_forbidden", "acceptance_criteria", "required_receipts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "spec_id": { "type": "string", "pattern": "^SPEC-[A-Z0-9\\-]+$" },
    "title": { "type": "string", "minLength": 5 },
    "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "IN_PROGRESS", "CLOSED", "REJECTED"] },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "type": ["string", "null"] },
    "closed_at": { "type": ["string", "null"], "format": "date-time" },
    "gate_id": { "type": ["string", "null"] },
    "objective": { "type": "string", "minLength": 10 },
    "rationale": { "type": "string" },
    "scope_in": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "scope_out": { "type": "array", "items": { "type": "string" } },
    "files_allowed_to_read": { "type": "array", "items": { "type": "string" } },
    "files_allowed_to_modify": { "type": "array", "items": { "type": "string" } },
    "files_forbidden": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "data_allowed": { "type": "array", "items": { "type": "string" } },
    "data_forbidden": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "description", "verification_method"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^AC-\\d+$" },
          "description": { "type": "string", "minLength": 5 },
          "verification_method": { "type": "string", "minLength": 5 },
          "receipt_required": { "type": ["string", "null"] }
        }
      }
    },
    "required_receipts": { "type": "array", "items": { "type": "string" } },
    "rollback_plan": { "type": "string" },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "severity", "mitigation"],
        "additionalProperties": false,
        "properties": {
          "risk": { "type": "string" },
          "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}

# QuantumBot Pro v3.0 — Variables de Entorno de Ejemplo
# NO colocar claves reales en este archivo.

# Credenciales de BingX (VST / Real)
BINGX_API_KEY=tu_api_key_bingx_aqui
BINGX_SECRET_KEY=tu_secret_key_bingx_aqui
CONFIRM_BINGX_VST=NO

# Credenciales de Bybit Demo
BYBIT_API_KEY=tu_api_key_bybit_demo_aqui
BYBIT_SECRET_KEY=tu_secret_key_bybit_demo_aqui

# Credenciales de Bybit Real
BYBIT_REAL_API_KEY=tu_api_key_bybit_real_aqui
BYBIT_REAL_SECRET_KEY=tu_secret_key_bybit_real_aqui

# Candado de Seguridad para Operar en Cuenta Real (P0.2)
# Requerido únicamente cuando environment: "live" o "real" en settings.yaml
ALLOW_LIVE_TRADING=false
